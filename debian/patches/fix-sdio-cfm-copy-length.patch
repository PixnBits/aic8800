 .../aic8800/aic8800_bsp/aic_bsp_driver.h       |  1 +
 .../driver/aic8800/aic8800_fdrv/rwnx_cmds.c    |  9 +++++++--
 .../driver/aic8800/aic8800_fdrv/rwnx_cmds.h    |  1 +
 .../driver/aic8800/aic8800_fdrv/rwnx_msg_tx.c  | 15 +++++++++++----
 5 files changed, 34 insertions(+), 10 deletions(-)

diff --git a/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c b/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c
index 9788152..9022ad2 100644
--- a/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c
+++ b/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c
@@ -177,8 +177,13 @@ static int cmd_mgr_msgind(struct rwnx_cmd_mgr *cmd_mgr, struct rwnx_cmd_e2amsg *
 					msg->param_len = RWNX_CMD_E2AMSG_LEN_MAX;
 				}
 
-				if (cmd->e2a_msg && msg->param_len)
-					memcpy(cmd->e2a_msg, &msg->param, msg->param_len);
+				if (cmd->e2a_msg && msg->param_len) {
+					u16 copy_len = min_t(u16, msg->param_len, cmd->e2a_len);
+					if (msg->param_len > cmd->e2a_len)
+						pr_warn_ratelimited("rwnx: cfm 0x%x len %u > buffer %u, truncated\n",
+								    msg->id, msg->param_len, cmd->e2a_len);
+					memcpy(cmd->e2a_msg, &msg->param, copy_len);
+				}
 
 				if (RWNX_CMD_WAIT_COMPLETE(cmd->flags))
 					cmd_complete(cmd_mgr, cmd);
@@ -324,8 +329,12 @@ static void rwnx_msg_free(struct lmac_msg *msg, const void *msg_params)
 }
 
 
-static int rwnx_send_msg(struct aic_sdio_dev *sdiodev, const void *msg_params,
-						 int reqcfm, lmac_msg_id_t reqid, void *cfm)
+/* copy the confirmation into the caller's buffer, never more than its real size
+ * (recorded per command at send time from sizeof(*cfm)) */
+#define RWNX_CFM_SZ(c) __builtin_choose_expr(__builtin_types_compatible_p(typeof(c), void *), (size_t)0, sizeof(*(c)))
+#define rwnx_send_msg(h, p, r, i, c) rwnx_send_msg_sz(h, p, r, i, c, RWNX_CFM_SZ(c))
+static int rwnx_send_msg_sz(struct aic_sdio_dev *sdiodev, const void *msg_params,
+						 int reqcfm, lmac_msg_id_t reqid, void *cfm, size_t cfm_len)
 {
 	struct lmac_msg *msg;
 	struct rwnx_cmd *cmd;
@@ -346,6 +355,7 @@ static int rwnx_send_msg(struct aic_sdio_dev *sdiodev, const void *msg_params,
 	cmd->reqid   = reqid;
 	cmd->a2e_msg = msg;
 	cmd->e2a_msg = cfm;
+	cmd->e2a_len = cfm ? (u16)min_t(size_t, cfm_len, 0xffff) : 0;
 	if (nonblock)
 		cmd->flags = RWNX_CMD_FLAG_NONBLOCK;
 	if (reqcfm)
